# ==============================
# RAG Evaluation Environment
# ==============================

# Backend to evaluate
EVAL_BASE_URL=http://localhost:8000
EVAL_SEARCH_ENDPOINT=/api/v1/search
EVAL_CHAT_ENDPOINT=/api/v1/chat

# Dataset path
EVAL_DATASET_PATH=evaluation-rag/dataset/query_set.v1.json

# Judge model (OpenAI-compatible)
JUDGE_BASE_URL=https://api.openai.com/v1
JUDGE_MODEL=gpt-4o-mini
JUDGE_API_KEY=

# RAGAS evaluator (used by scripts/ragas_eval.py)
OPENAI_API_KEY=

# Optional tuning
EVAL_TOP_K_CONTEXT=5
EVAL_TIMEOUT_SEC=30
